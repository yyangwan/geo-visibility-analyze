# 智见 (ZhiJian) - Required Environment Variables
# Copy this file to .env and fill in your values

# REQUIRED: JWT signing key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
AISCOPE_SECRET_KEY=change-me-to-a-random-string

# OPTIONAL: Enable debug mode (allows default secret key)
# AISCOPE_DEBUG=1

# OPTIONAL: GeniLink service JWT verification.
# JWKS must be reachable from the backend host; issuer must match Portal-issued tokens.
# AISCOPE_GENILINK_JWKS_URL=https://genilink.cn/.well-known/jwks.json
# AISCOPE_GENILINK_ISSUER=https://app.genilink.cn
# AISCOPE_GENILINK_AUDIENCE=visibility.genilink.cn

# Platform API keys (set the ones you want to use)
AISCOPE_DEEPSEEK_API_KEY=
AISCOPE_DEEPSEEK_WEB_AUTH_TOKEN=
AISCOPE_DEEPSEEK_WEB_COOKIE=
AISCOPE_DEEPSEEK_WEB_USER_AGENT=
AISCOPE_DEEPSEEK_WEB_HEADERS_JSON=
AISCOPE_DEEPSEEK_WEB_CHAT_SESSION_ID=
AISCOPE_DEEPSEEK_WEB_PARENT_MESSAGE_ID=
AISCOPE_DEEPSEEK_WEB_MODEL_TYPE=
AISCOPE_BOCHA_API_KEY=
# AISCOPE_BOCHA_BASE_URL=https://api.bocha.cn
# AISCOPE_BOCHA_SEARCH_ENDPOINT=/v1/web-search
AISCOPE_QWEN_API_KEY=
AISCOPE_DOUBAO_API_KEY=
AISCOPE_KIMI_API_KEY=
AISCOPE_WENXIN_API_KEY=
AISCOPE_HUNYUAN_API_KEY=

# OPTIONAL: Override LLM for internal tasks (defaults to DeepSeek)
# AISCOPE_LLM_API_KEY=
# AISCOPE_LLM_BASE_URL=
# AISCOPE_LLM_MODEL=

# OPTIONAL: Timezone for scheduler (default: Asia/Shanghai)
# AISCOPE_TZ=Asia/Shanghai

# OPTIONAL: Product website visibility analysis
# Native crawler is the default. Set provider to firecrawl only when an API key is configured.
# AISCOPE_PRODUCT_WEBSITE_CRAWLER_PROVIDER=native
# AISCOPE_PRODUCT_WEBSITE_CRAWLER_TIMEOUT_SECONDS=30
# AISCOPE_FIRECRAWL_API_KEY=
# AISCOPE_FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# AISCOPE_FIRECRAWL_WAIT_FOR_MS=1000
# AISCOPE_FIRECRAWL_MAX_AGE_MS=172800000

# OPTIONAL: Real AI citation checks for product website analysis.
# Disabled by default to avoid model-call cost on every run. The UI can override per run.
# AISCOPE_PRODUCT_WEBSITE_AI_CITATION_ENABLED=false
# AISCOPE_PRODUCT_WEBSITE_AI_CITATION_PLATFORMS=deepseek,doubao,hunyuan,qwen,kimi
# AISCOPE_PRODUCT_WEBSITE_AI_CITATION_PROMPT_LIMIT=2

# Platform audit response collection. Production defaults to mobile-app capture.
# Set to false to roll back to the original platform API adapters.
AISCOPE_MOBILE_APP_CAPTURE_ENABLED=false
AISCOPE_MOBILE_APP_CAPTURE_PLATFORMS=deepseek,doubao,hunyuan,qwen,kimi
AISCOPE_MOBILE_APP_CAPTURE_GATEWAY_ID=CHAO
# AISCOPE_MOBILE_APP_CAPTURE_DEVICE_SERIAL=PQY5T20B26021334
# AISCOPE_MOBILE_APP_CAPTURE_TASK_TIMEOUT_SECONDS=420
# AISCOPE_MOBILE_APP_CAPTURE_WAIT_TIMEOUT_SECONDS=1200
# AISCOPE_MOBILE_APP_CAPTURE_POLL_INTERVAL_SECONDS=2
# AISCOPE_MOBILE_APP_CAPTURE_MAX_ATTEMPTS=3
# AISCOPE_MOBILE_APP_CAPTURE_PRIORITY=10
